{
  "e2e": {
    "visual": {
      "mode": "smoke",
      "viewports": [
        {
          "name": "desktop-1280x800",
          "width": 1280,
          "height": 800
        },
        {
          "name": "desktop-1440x900",
          "width": 1440,
          "height": 900
        },
        {
          "name": "compact-800x600",
          "width": 800,
          "height": 600
        }
      ],
      "routes": [
        {
          "name": "interview-input",
          "state": "default",
          "actual": "/entries/interview-input.html",
          "whole_page": true,
          "capture_full_page": true,
          "state_assertions": [
            {
              "type": "visible",
              "selector": "[contenteditable=\"true\"]"
            }
          ]
        }
      ]
    }
  }
}
