      "trigger": {
        "selector": "[data-home-view='catalog']"
      },
      "fixture": {
        "id": "default",
        "label": "查找未固定 App"
      }
    },
    {
      "id": "open-writing",
      "from": "app-catalog",
      "to": "app-open",
      "action": "点击商务写作的“打开”",
      "condition": "搜索结果来自桥见圈子且当前可使用",
      "systemResult": "商务写作以独立 Tab 打开，并显示来源与固定版本",
      "resultType": "navigation",
      "trigger": {
        "selector": "[data-open='writing']"
      },
      "fixture": {
        "id": "default",
        "label": "商务写作可使用"
      }
    },
    {
      "id": "start-writing",
      "from": "app-open",
      "to": "app-preparing",
      "action": "点击“开始使用”",
      "condition": "当前空间、授权与版本重新验证通过",
      "systemResult": "执行请求被接受并进入准备中",
      "resultType": "success",
      "trigger": {
        "selector": "[data-start-app='writing']"
      },
      "fixture": {
        "id": "default",
        "label": "验证通过并准备执行"
      }
    }
