    {
      "id": "open-assistant",
      "from": "space-home",
      "to": "assistant-boundary",
      "action": "点击“打开助手”",
      "condition": "用户希望直接让 Polo 助手处理任务",
      "systemResult": "Polo 助手在当前空间的 Tab 中打开",
      "resultType": "success",
      "trigger": {
        "selector": "[data-open='assistant']"
      },
      "fixture": {
        "id": "default",
        "label": "默认助手入口"
      }
    },
    {
      "id": "browse-all-apps",
      "from": "space-home",
