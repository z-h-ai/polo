#!/bin/sh
# Polo CLI launcher (managed by Polo AI)

SOURCE=$0
while [ -h "$SOURCE" ]; do
  SOURCE_DIR=$(CDPATH= cd -P -- "$(dirname -- "$SOURCE")" && pwd)
  SOURCE=$(readlink "$SOURCE")
  case "$SOURCE" in
    /*) ;;
    *) SOURCE="$SOURCE_DIR/$SOURCE" ;;
  esac
done

BIN_DIR=$(CDPATH= cd -P -- "$(dirname -- "$SOURCE")" && pwd)
APP_ROOT=$(CDPATH= cd -- "$BIN_DIR/../.." && pwd)

if [ -x "$APP_ROOT/vendor/bun/bun" ]; then
  RESOURCES_ROOT="$APP_ROOT"
else
  RESOURCES_ROOT=$(CDPATH= cd -- "$APP_ROOT/.." && pwd)
fi

BUN="$RESOURCES_ROOT/vendor/bun/bun"
CLI="$APP_ROOT/dist/cli/polo-cli.js"
SERVER="$APP_ROOT/dist/server/polo-server.js"

POLO_LOCALE="${POLO_AI_LOCALE:-${LC_ALL:-${LC_MESSAGES:-${LANG:-en}}}}"
case "$POLO_LOCALE" in
  zh|zh[_-]*)
    RUNTIME_MISSING="错误：Polo 内置运行时缺失。请重新安装 Polo。"
    TERMINAL_FILES_MISSING="错误：Polo 终端文件缺失。请重新安装 Polo。"
    ;;
  de|de[_-]*)
    RUNTIME_MISSING="Fehler: Die gebündelte Polo-Laufzeit fehlt. Installiere Polo erneut."
    TERMINAL_FILES_MISSING="Fehler: Polo-Terminaldateien fehlen. Installiere Polo erneut."
    ;;
  es|es[_-]*)
    RUNTIME_MISSING="Error: Falta el entorno de ejecución incluido de Polo. Reinstala Polo."
    TERMINAL_FILES_MISSING="Error: Faltan los archivos de terminal de Polo. Reinstala Polo."
    ;;
  hu|hu[_-]*)
    RUNTIME_MISSING="Hiba: A Polo beépített futtatókörnyezete hiányzik. Telepítsd újra a Polót."
    TERMINAL_FILES_MISSING="Hiba: A Polo terminálfájljai hiányoznak. Telepítsd újra a Polót."
    ;;
  ja|ja[_-]*)
    RUNTIME_MISSING="エラー: Polo の内蔵ランタイムがありません。Polo を再インストールしてください。"
    TERMINAL_FILES_MISSING="エラー: Polo のターミナルファイルがありません。Polo を再インストールしてください。"
    ;;
  pl|pl[_-]*)
    RUNTIME_MISSING="Błąd: Brakuje dołączonego środowiska uruchomieniowego Polo. Zainstaluj Polo ponownie."
    TERMINAL_FILES_MISSING="Błąd: Brakuje plików terminala Polo. Zainstaluj Polo ponownie."
    ;;
  *)
    RUNTIME_MISSING="Error: Polo's bundled runtime is missing. Reinstall Polo."
    TERMINAL_FILES_MISSING="Error: Polo terminal files are missing. Reinstall Polo."
    ;;
esac

if [ ! -x "$BUN" ]; then
  printf '%s\n' "[POLO_E_BUNDLED_RUNTIME_MISSING] $RUNTIME_MISSING" >&2
  exit 1
fi
if [ ! -f "$CLI" ] || [ ! -f "$SERVER" ]; then
  printf '%s\n' "[POLO_E_TERMINAL_FILES_MISSING] $TERMINAL_FILES_MISSING" >&2
  exit 1
fi

export POLO_AI_BUN="$BUN"
export POLO_AI_SERVER_ENTRY="$SERVER"
export POLO_AI_APP_ROOT="$APP_ROOT"
export POLO_AI_RESOURCES_PATH="$APP_ROOT/resources"
export POLO_AI_BUNDLED_ASSETS_ROOT="$APP_ROOT"
export POLO_AI_IS_PACKAGED=true

case "$(uname -s)" in
  Darwin)
    export POLO_AI_DESKTOP_APP="$RESOURCES_ROOT/../.."
    ;;
  Linux)
    if [ -n "$APPIMAGE" ]; then
      export POLO_AI_APPIMAGE="$APPIMAGE"
    else
      INSTALLED_APPIMAGE_DIR=$(CDPATH= cd -- "$RESOURCES_ROOT/../.." && pwd)
      INSTALLED_APPIMAGE="$INSTALLED_APPIMAGE_DIR/Polo-AI-x64.AppImage"
      if [ -x "$INSTALLED_APPIMAGE" ]; then
        export POLO_AI_APPIMAGE="$INSTALLED_APPIMAGE"
      fi
    fi
    ;;
esac

exec "$BUN" run "$CLI" "$@"
