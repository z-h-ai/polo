{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"], "types": [], "strict": true,
    "declaration": true, "emitDeclarationOnly": true, "outDir": "dist", "rootDir": "src",
    "skipLibCheck": true
  },
  "include": ["src/*.ts"], "exclude": ["src/*.test.ts"]
}
