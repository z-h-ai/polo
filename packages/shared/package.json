{
  "name": "@z-h-ai/shared",
  "version": "0.11.1",
  "private": true,
  "license": "Apache-2.0",
  "description": "Shared business logic for Polo AI - agent, auth, config, credentials, MCP integration",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/z-h-ai/polo.git",
    "directory": "packages/shared"
  },
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "files": [
    "dist",
    "src",
    "package.json"
  ],
  "scripts": {
    "build:creator-skills": "bun run scripts/build-creator-skills.ts",
    "build": "bun run build:creator-skills",
    "stage:creator-skills-package": "bun run scripts/stage-creator-skills-package.ts",
    "prepack": "bun run build && bun run stage:creator-skills-package",
    "test": "bun run build:creator-skills && bun test",
    "test:creator-skills-package": "bun run scripts/verify-creator-skills-package.ts",
    "test:creator-skills-package-failures": "bun run scripts/verify-proof-failure-lifecycle.ts",
    "test:creator-skills-package-lifecycle": "bun run scripts/verify-creator-skills-package-lifecycle.ts",
    "test:watch": "bun test --watch",
    "sync:polo-ai-bash-patterns": "bun run src/config/sync-polo-ai-bash-patterns.ts"
  },
  "publishConfig": {
    "access": "restricted",
    "registry": "https://npm.pkg.github.com"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "exports": {
    ".": "./src/index.ts",
    "./agent": "./src/agent/index.ts",
    "./agent/modes": "./src/agent/mode-types.ts",
    "./agent/mode-types": "./src/agent/mode-types.ts",
    "./agent/thinking-levels": "./src/agent/thinking-levels.ts",
    "./admin": "./src/admin/index.ts",
    "./admin/authorization": "./src/admin/authorization-failure.ts",
    "./admin/catalog-view": "./src/admin/app-catalog-view.ts",
    "./admin/context-key": "./src/admin/context-key.ts",
    "./admin/semver": "./src/admin/semver.ts",
    "./admin/schemas": "./src/admin/schemas.ts",
    "./auth": "./src/auth/index.ts",
    "./auth/callback-page": "./src/auth/callback-page.ts",
    "./auth/types": "./src/auth/types.ts",
    "./config": "./src/config/index.ts",
    "./config/home-recent": "./src/config/home-recent.ts",
    "./config/organization-context": "./src/config/organization-context.ts",
    "./docs": "./src/docs/index.ts",
    "./docs/doc-links": "./src/docs/doc-links.ts",
    "./config/types": "./src/config/types.ts",
    "./credentials": "./src/credentials/index.ts",
    "./mcp": "./src/mcp/index.ts",
    "./prompts": "./src/prompts/index.ts",
    "./sessions": "./src/sessions/index.ts",
    "./sources": "./src/sources/index.ts",
    "./sources/types": "./src/sources/types.ts",
    "./skills": "./src/skills/index.ts",
    "./creator-skills": {
      "types": "./dist/creator-skills/index.d.ts",
      "import": "./dist/creator-skills/index.cjs",
      "require": "./dist/creator-skills/index.cjs",
      "default": "./dist/creator-skills/index.cjs"
    },
    "./creator-skills/fixtures": {
      "types": "./dist/creator-skills/fixtures.d.ts",
      "import": "./dist/creator-skills/fixtures.cjs",
      "require": "./dist/creator-skills/fixtures.cjs",
      "default": "./dist/creator-skills/fixtures.cjs"
    },
    "./workspaces": "./src/workspaces/index.ts",
    "./utils": "./src/utils/index.ts",
    "./utils/toolNames": "./src/utils/toolNames.ts",
    "./utils/logo": "./src/utils/logo.ts",
    "./utils/service-url": "./src/utils/service-url.ts",
    "./utils/icon": "./src/utils/icon.ts",
    "./icons": "./src/icons/index.ts",
    "./colors": "./src/colors/index.ts",
    "./utils/icon-constants": "./src/utils/icon-constants.ts",
    "./utils/url-safety": "./src/utils/url-safety.ts",
    "./utils/workspace": "./src/utils/workspace.ts",
    "./utils/workspace-slug": "./src/utils/workspace-slug.ts",
    "./labels": "./src/labels/index.ts",
    "./labels/auto": "./src/labels/auto/index.ts",
    "./labels/storage": "./src/labels/storage.ts",
    "./labels/crud": "./src/labels/crud.ts",
    "./views": "./src/views/index.ts",
    "./views/storage": "./src/views/storage.ts",
    "./validation": "./src/validation/index.ts",
    "./version": "./src/version/index.ts",
    "./branding": "./src/branding.ts",
    "./feature-flags": "./src/feature-flags.ts",
    "./interceptor": "./src/interceptor-common.ts",
    "./search": "./src/search/index.ts",
    "./tools": "./src/tools/index.ts",
    "./mentions": "./src/mentions/index.ts",
    "./skills/types": "./src/skills/types.ts",
    "./automations": "./src/automations/index.ts",
    "./automations/resolve-config-path": "./src/automations/resolve-config-path.ts",
    "./protocol": "./src/protocol/index.ts",
    "./i18n": "./src/i18n/index.ts",
    "./resources": "./src/resources/index.ts"
  },
  "dependencies": {
    "@isaacs/ttlcache": "^2.1.4",
    "@leeoniya/ufuzzy": "^1.0.19",
    "bash-parser": "^0.5.0",
    "croner": "^10.0.1",
    "filtrex": "^3.1.0",
    "glob": "^13.0.0",
    "date-fns": "^4.1.0",
    "fflate": "^0.8.2",
    "i18next": "^26.0.3",
    "incr-regex-package": "^1.0.4",
    "shell-quote": "^1.8.3",
    "yauzl": "^2.10.0",
    "@mariozechner/pi-agent-core": "0.73.1",
    "@mariozechner/pi-ai": "0.73.1",
    "@mariozechner/pi-coding-agent": "0.73.1"
  },
  "peerDependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.2.123",
    "@modelcontextprotocol/sdk": ">=1.0.0",
    "zod": ">=3.0.0"
  },
  "devDependencies": {
    "@types/shell-quote": "^1.7.5",
    "@types/uuid": "^11.0.0",
    "@types/yauzl": "^2.10.3"
  }
}
