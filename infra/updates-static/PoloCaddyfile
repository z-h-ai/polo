{
  admin off
  auto_https off
}

:8080 {
  root * /data/releases

  route {
    # The PVC also contains release staging, locks, and rollback state. These
    # paths are never public, even when an immutable wildcard would otherwise
    # match them. `route` preserves this deny rule ahead of file_server routes.
    @internalReleaseState {
      path /electron/.incoming /electron/.incoming/* /electron/.publisher.lock /electron/.rollback-* /electron/.confirmed-* /electron/releases/.* /electron/releases/.*/* /electron/latest/.* /electron/latest/.*/*
    }
    respond @internalReleaseState "Not found" 404

    @latestManifests {
      method GET HEAD
      path /electron/latest/latest-mac.yml /electron/latest/latest.yml /electron/latest/latest-linux.yml /electron/latest/release-contract.json /electron/latest/install-app.sh
    }
    handle @latestManifests {
      header Cache-Control "no-cache"
      file_server
    }

    @immutableArtifacts {
      method GET HEAD
      path /electron/latest/* /electron/releases/*
    }
    handle @immutableArtifacts {
      header Cache-Control "public, max-age=31536000, immutable"
      file_server
    }

    @readonly method GET HEAD
    handle @readonly {
      file_server
    }

    respond "Method not allowed" 405
  }
}
