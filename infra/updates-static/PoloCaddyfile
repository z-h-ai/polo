{
  admin off
  auto_https off
}

:8080 {
  root * /data/releases

  route {
    # The PVC also contains release staging, locks, and rollback state. These
    # paths are never public, even when an immutable wildcard would otherwise
    # match them. `route` preserves this deny rule ahead of file_server routes.
    @internalReleaseState {
      # Every dot-prefixed name below electron is publisher state, including
      # lock children and the temporary latest symlink used during rename.
      # The second expression closes hidden entries inside public namespaces.
      path_regexp release_internal ^/electron(?:/\.[^/]+(?:/.*)?|/(?:latest|releases/[^/]+)/\.[^/]+(?:/.*)?)$
    }
    respond @internalReleaseState "Not found" 404

    # Version directories are an implementation detail until their content is
    # selected by electron/latest. Serving only latest prevents an unconfirmed
    # staging publish from being fetched by guessing its versioned path.
    @releaseDirectories path /electron/releases /electron/releases/*
    respond @releaseDirectories "Not found" 404

    @latestManifests {
      method GET HEAD
      path /electron/latest/latest-mac.yml /electron/latest/latest.yml /electron/latest/latest-linux.yml /electron/latest/release-contract.json /electron/latest/install-app.sh
    }
    handle @latestManifests {
      header Cache-Control "no-cache"
      file_server
    }

    @immutableArtifacts {
      method GET HEAD
      path /electron/latest/*
    }
    handle @immutableArtifacts {
      header Cache-Control "public, max-age=31536000, immutable"
      file_server
    }

    @readonly method GET HEAD
    handle @readonly {
      file_server
    }

    respond "Method not allowed" 405
  }
}
