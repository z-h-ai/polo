  "stories": [
    {
      "id": "S1",
      "name": "故事 1 · 首登加入企业并使用",
      "steps": [
        {
          "screen": "P-M01-LOGIN-PASSWORD",
          "screen_title": "登录 · 密码登录",
          "narration": "小王首次使用 Polo，用账号密码登录。"
        },
        {
          "screen": "P-M01-PERSONAL-PREP",
          "screen_title": "我的空间 · 准备中",
          "narration": "登录成功，系统为它准备唯一的「我的空间」。"
        },
        {
          "screen": "P-M03-HOME-ZERO",
          "screen_title": "首页 · 首登零常用",
          "narration": "首登还没有常用 App：助手始终可用，引导去全部 Apps。"
        },
        {
          "screen": "P-M03-ALL-APPS",
          "screen_title": "全部 Apps · 来源分组",
          "narration": "在全部 Apps 里按来源浏览：企业分发、圈子作品。"
        },
        {
          "screen": "P-M03-INSPECTOR",
          "screen_title": "App 详情（inspector）",
          "narration": "查看详情：来源、版本与状态原因都在这里核对。"
        },
        {
          "screen": "P-M04-PREPARE",
          "screen_title": "准备与权限确认",
          "narration": "准备「合同审查」更新：确认权限后下载。"
        },
        {
          "screen": "P-M04-APP-VIEW",
          "screen_title": "App 容器 · 全屏 FDE 占位",
          "narration": "App 占满主内容工作区，内部界面归 FDE（原型为中性占位）。"
        },
        {
          "screen": "P-M05-CHAT",
          "screen_title": "助手 · 对话生成中",
          "narration": "回到 Polo 助手，让助手基于附件整理报价汇总。"
        },
        {
          "screen": "P-M08-FILES",
          "screen_title": "原对话文件",
          "narration": "附件与生成文件都留在会话里，重开后可继续。"
        }
      ]
    },
    {
      "id": "S2",
      "name": "故事 2 · 日常切换空间（部分停止失败）",
      "steps": [
        {
          "screen": "P-M03-HOME-ENT",
          "screen_title": "首页 · 企业空间（晨星科技）",
          "narration": "小王在晨星科技工作，首页显示 3 项运行中。"
        },
        {
          "screen": "P-M04-RUNTIME",
          "screen_title": "运行状态中心",
          "narration": "运行状态中心按空间列出本机任务：App 与助手生成。"
        },
        {
          "screen": "P-M02-SWITCHER",
          "screen_title": "空间切换器（下拉）",
          "narration": "从顶栏空间切换器发起切换；有活动任务时会先确认。"
        },
        {
          "screen": "P-M02-CONFIRM",
          "screen_title": "切换确认 · 终止 3 项",
          "narration": "确认框列出将被终止的 3 项任务。"
        },
        {
          "screen": "P-M02-STOPPING",
          "screen_title": "终止进度",
          "narration": "逐项终止中；全部停止后才提交切换。"
        },
        {
          "screen": "P-M02-STOP-FAILED",
          "screen_title": "部分停止失败",
          "narration": "1 项未能终止：重试失败项，或取消切换。"
        },
        {
          "screen": "P-M02-STOP-CANCEL",
          "screen_title": "取消切换 · 仍在原空间",
          "narration": "小王取消切换：留在晨星科技，已终止的项不会自动复活。"
        },
        {
          "screen": "P-M04-BACKGROUND",
          "screen_title": "后台继续",
          "narration": "改为后台继续：顶栏保留运行入口，随时可查看。"
        }
      ]
    },
    {
      "id": "S3",
      "name": "故事 3 · 积分不足 → 浏览器 → 单次查询",
      "steps": [
        {
          "screen": "P-M05-CHAT",
          "screen_title": "助手 · 对话生成中",
          "narration": "小王正在让助手按客户分组整理报价汇总。"
        },
        {
          "screen": "P-M09-PRE-BLOCK",
          "screen_title": "发送前积分不足",
          "narration": "发送前发现积分不足：输入保留，发送不可用。"
        },
        {
          "screen": "P-M09-BROWSER",
          "screen_title": "充值（浏览器交接）",
          "narration": "去浏览器完成充值；桌面端只发起与确认结果。"
        },
        {
          "screen": "P-M09-CHECKING",
          "screen_title": "返回后 · 单次查询中",
          "narration": "回到 Polo：只做一次到账查询，会话与草稿保留。"
        },
        {
          "screen": "P-M09-NOT-YET",
          "screen_title": "未到账 / 查询失败",
          "narration": "第一次查询未到账：保持阻断，可再查一次。"
        },
        {
          "screen": "P-M09-RESUMED",
          "screen_title": "到账解除 · 由用户决定",
          "narration": "积分到账：解除阻断，但不自动发送——由小王决定。"
        },
        {
          "screen": "P-M05-CHAT",
          "screen_title": "助手 · 对话生成中",
          "narration": "小王自己点下发送，继续刚才的整理。"
        }
      ]
    }
  ],
