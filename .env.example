# Required: Anthropic API Key for Claude
ANTHROPIC_API_KEY=sk-ant-...

# Required: Polo AI MCP Server URL
# Format: http://localhost:3000/v1/links/{secretLinkId}/mcp
POLO_MCP_URL=http://localhost:3000/v1/links/YOUR_SECRET_LINK_ID/mcp

# Required: Bearer token for MCP authentication
POLO_MCP_TOKEN=your-bearer-token-here

# Google OAuth Configuration (OPTIONAL - for development/testing only)
# For production use, users should provide their own credentials via source configuration.
# These env vars serve as a fallback if source config doesn't specify credentials.
# See README_FOR_OSS.md for setup instructions.
# To create credentials: Google Cloud Console > APIs & Services > Credentials > Desktop app
# GOOGLE_OAUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com
# GOOGLE_OAUTH_CLIENT_SECRET=your-client-secret

# Slack OAuth Configuration (for Slack workspace integration)
# Get these from Slack API > Your Apps > OAuth & Permissions
SLACK_OAUTH_CLIENT_ID=your-slack-client-id
SLACK_OAUTH_CLIENT_SECRET=your-slack-client-secret

# Microsoft OAuth Configuration (for Outlook, OneDrive, Teams integration)
# Get these from Azure Portal > App Registrations
# Note: Create a "Mobile and desktop applications" platform OAuth client - PKCE is used so no client_secret is needed
MICROSOFT_OAUTH_CLIENT_ID=your-microsoft-client-id

# Sentry Error Tracking (captures crashes and chat/SDK errors)
# Get the ingest URL from Sentry > Project Settings > Client Keys (DSN)
SENTRY_ELECTRON_INGEST_URL=https://your-public-key@o0.ingest.sentry.io/0

# Enterprise Knowledge Base storage service (POO-108 v3.1)
# The knowledge base feature is DISABLED unless POLO_OPENVIKING_URL is set:
# every KB RPC then answers "the knowledge base service is temporarily
# unavailable", phrased without naming the storage vendor (end users must
# never learn one exists).
#
# Deployment boundary (brief D2 — read before enabling on real data):
#   POLO_OPENVIKING_ROOT_API_KEY is the SERVICE'S ROOT KEY. It can create and
#   enter EVERY tenant (account) on the instance and is therefore only
#   acceptable while the instance is single-enterprise / controlled-dev.
#   It is used exclusively by the admin plane to provision and recover each
#   space's tenant credential; all day-to-day reads and writes use the
#   per-space tenant key (no root key on any read path). Multi-enterprise
#   rollouts MUST move root-key custody to the admin service first.
#   The key must never be committed to the repository or written to logs.
# POLO_OPENVIKING_URL=http://127.0.0.1:1933
# POLO_OPENVIKING_ROOT_API_KEY=replace-with-the-instance-root-key
#
# Cloud-MANAGED library mode (POO-108 v4 D-A) — the alternative to the root
# key above for a vendor-hosted OpenViking Context library. The key comes from
# the cloud console's user management (or TOP AccessOpenVikingApiKey) and IS
# the data-plane credential: no provisioning plane exists, every space nests
# under its own derived directory inside the ONE library, and requests carry
# both Authorization: Bearer and X-API-Key with this key. Setting it IGNORES
# POLO_OPENVIKING_ROOT_API_KEY (the conflict is warned once in the server log).
# POLO_OPENVIKING_API_KEY=replace-with-the-managed-library-key
#
# How uploaded documents are processed by the storage service (ingestion
# profile): "vectors_only" (default, lean) or "semantic_and_vectors".
# POLO_OPENVIKING_PROCESSING_MODE=vectors_only
